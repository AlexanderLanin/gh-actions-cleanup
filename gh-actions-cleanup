#!/usr/bin/env bash
set -euo pipefail

days=30
parallel=10
apply=false
repo=""

usage() {
    cat <<EOF
Usage:
  gh actions-cleanup [options]

Options:
  --days N       Delete runs older than N days (default: 30)
  --parallel N   Parallel deletions (default: 10)
  --repo OWNER/REPO
  --apply        Actually delete runs
  -h, --help
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --days)
            days="$2"
            shift 2
            ;;
        --parallel)
            parallel="$2"
            shift 2
            ;;
        --repo|-R)
            repo="$2"
            shift 2
            ;;
        --apply)
            apply=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if [[ -z "$repo" ]]; then
    repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
fi

cutoff=$(date -u -d "$days days ago" '+%Y-%m-%dT%H:%M:%SZ')

mapfile -t run_ids < <(
    gh run list \
        --repo "$repo" \
        --limit 1000 \
        --json databaseId,createdAt \
        --jq ".[] | select(.createdAt < \"$cutoff\") | .databaseId"
)

echo "Repository: $repo"
echo "Cutoff:     $cutoff"
echo "Runs:       ${#run_ids[@]}"

if [[ ${#run_ids[@]} -eq 0 ]]; then
    exit 0
fi

if [[ "$apply" != true ]]; then
    printf '%s\n' "${run_ids[@]}"
    echo
    echo "Dry-run only. Use --apply to delete."
    exit 0
fi

printf '%s\n' "${run_ids[@]}" |
    xargs -r -n1 -P"$parallel" bash -c '
        run_id="$1"
        echo "Deleting run $run_id"
        gh api \
            --method DELETE \
            "repos/'"$repo"'/actions/runs/$run_id"
    ' _

echo "Deleted ${#run_ids[@]} runs."
